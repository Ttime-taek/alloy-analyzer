# Copy to .env. Never commit real keys.
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Comma-separated browser origins allowed to call the API.
ALLOY_API_CORS_ORIGINS=https://alloy-analyzer.vercel.app,http://localhost:5173

# Optional local bind settings used by scripts/dev.sh.
ALLOY_API_HOST=127.0.0.1
ALLOY_API_PORT=8000

# Optional protection for the separate, cost-bearing AI explanation endpoint.
ALLOY_EXPLANATION_RATE_LIMIT=6
ALLOY_EXPLANATION_RATE_WINDOW_SEC=60
ALLOY_EXPLANATION_CONCURRENCY=1

# Optional trusted-client access to shared favorites (minimum 32 characters).
# Keep this server-side only; the public web UI intentionally uses localStorage.
ALLOY_FAVORITES_SYNC_TOKEN=
