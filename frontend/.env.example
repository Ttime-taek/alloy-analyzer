# Local development can leave this empty because FastAPI serves the built UI.
# Vercel: set this to the deployed Render API URL, without a trailing slash.
VITE_API_BASE_URL=https://your-api-service.onrender.com

# API 서버 CORS 허용 출처는 서버의 .env에서 쉼표로 관리합니다.
# ALLOY_API_CORS_ORIGINS=https://alloy-analyzer.vercel.app,http://localhost:5173
